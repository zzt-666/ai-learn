# 衰衰闯关 · 后端环境变量示例
# 复制为 .env 后填写真实值；勿将 .env 提交到 Git

# ---------- DeepSeek（Phase 0 已有）----------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
QUIZ_TIMEOUT_SECONDS=90
REPORT_TIMEOUT_SECONDS=90
SOURCE_EXCERPT_MAX_CHARS=2000

# ---------- Tavily 联网出题增强 ----------
TAVILY_API_KEY=
QUIZ_AGENT_TIMEOUT_SECONDS=120
# true：默认每次出题尝试联网检索；失败静默降级为模型知识出题
QUIZ_WEB_GROUNDING=true

# ---------- 微信小程序（用户系统）----------
# 微信公众平台 → 开发 → 开发管理 → 开发设置
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# true：开发/单测可用 Mock 登录（不调微信 code2Session）
# 真机正式联调前改为 false，并确保 APP_ID / APP_SECRET 已填写
WECHAT_MOCK_LOGIN=true

# ---------- JWT 登录态 ----------
# 请填一段足够长的随机字符串（建议 ≥32 字符）
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_learn
# pytest 默认强制使用独立库，避免误清开发数据（见 tests/conftest.py）
# MYSQL_TEST_DATABASE=ai_learn_test

# ---------- 知识库 / RAG（百炼 Embedding + Chroma）----------
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
# OpenAI 兼容模式（无需 WorkspaceId）；有 Workspace 时可改为 workspace 主机
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHROMA_PERSIST_DIR=chroma_data
KB_MAX_FILE_BYTES=10485760
KB_MAX_DOCS_PER_BASE=20
KB_MAX_BASES_PER_USER=10

# ---------- 阿里云 OSS（头像公网 + 题库私有；单桶前缀隔离）----------
# 控制台：Bucket ACL 设为「私有」；Bucket Policy 仅允许 avatars/* 匿名 GetObject
# 微信合法域名（downloadFile / 图片）：{bucket}.oss-cn-hangzhou.aliyuncs.com
# 配齐后新上传走 OSS；未配齐时回退本地 uploads/（便于 pytest）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=zzt-wwcg
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
