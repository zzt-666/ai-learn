# 衰衰闯关 · 后端环境变量示例
# 复制为 .env 后填写真实值；勿将 .env 提交到 Git

# ---------- DeepSeek（Phase 0 已有）----------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
QUIZ_TIMEOUT_SECONDS=90
REPORT_TIMEOUT_SECONDS=90
SOURCE_EXCERPT_MAX_CHARS=2000

# ---------- 微信小程序（用户系统）----------
# 微信公众平台 → 开发 → 开发管理 → 开发设置
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# true：开发/单测可用 Mock 登录（不调微信 code2Session）
# 真机正式联调前改为 false，并确保 APP_ID / APP_SECRET 已填写
WECHAT_MOCK_LOGIN=true

# ---------- JWT 登录态 ----------
# 请填一段足够长的随机字符串（建议 ≥32 字符）
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_learn
